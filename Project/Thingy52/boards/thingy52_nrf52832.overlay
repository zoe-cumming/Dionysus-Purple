&pinctrl {
	pdm0_default_alt: pdm0_default_alt {
		group1 {
			psels = <NRF_PSEL(PDM_CLK, 0, 26)>,
				<NRF_PSEL(PDM_DIN, 0, 25)>;
		};
	};
};

dmic_dev: &pdm0 {
	status = "okay";
	pinctrl-0 = <&pdm0_default_alt>;
	pinctrl-names = "default";
};


&i2c0 {
    bh1745: bh1745@38 {
        reg = <0x38>;
        power-gpios = <&gpio0 30 GPIO_ACTIVE_HIGH>;
        label = "BH1745";
        status = "okay";
    };
};

&sx1509b {
    status = "okay";
};

&gpio0 {
    status = "okay";
};


&hts221 {
    status = "okay";
};



/ {
    aliases {
        temphum = &hts221;	
    };
};
